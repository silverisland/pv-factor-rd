        "mech.power.short-memory",
        "mech.site.capacity-normalization"
      ],
      "evidence_level": "K2",
      "status": "implemented",
      "data_availability": "available",
      "required_inputs": [
        "power_history",
        "effective_capacity"
      ],
      "output_type": "history_sequence",
      "parameters": {
        "history_steps": [
          1,
          4,
          16,
          96
        ]
      },
      "formula": "P[forecast_origin-lag] / effective_capacity",
      "availability_rule": "All power samples and capacity version are available by forecast_origin",
      "expected_horizon": {
        "0_1h": "strong",
        "1_2h": "medium",
        "2_4h": "medium"
      },
      "assumptions": [
        "Configured installed capacity is valid for the experiment period"
      ],
      "failure_modes": [
        "Missing or stale capacity",
        "Partial availability"
      ],
      "implementation": "factor_library/implementations/pv_expert.py:build_capacity_ratio",
      "diagnostics": [
        "coverage",
        "range",
        "per_station_distribution"
      ]
    },
