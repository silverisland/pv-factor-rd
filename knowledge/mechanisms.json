    {
      "id": "mech.power.short-memory",
      "title": "Recent PV power carries short-horizon persistence",
      "domain": "time_series",
      "claim": "Recent normalized power and its local trajectory are strong references at short horizons, with influence generally decaying toward four hours.",
      "causal_chain": [
        "Weather and operating state persist",
        "Recent power summarizes their net effect",
        "Near-future power remains conditionally related"
      ],
      "required_variables": [
        "power_history",
        "capacity"
      ],
      "expected_horizon": {
        "0_1h": "strong",
        "1_2h": "medium",
        "2_4h": "weak_to_medium"
      },
      "assumptions": [
        "Recent measurement is timely",
        "No unobserved operational state change"
      ],
      "failure_modes": [
        "Fast cloud transition",
        "Curtailment or outage",
        "Stale telemetry"
      ],
      "source_ids": [
        "src.nrel.best-practices-solar-forecasting",
        "src.openclimatefix.pv-site-prediction"
      ],
      "evidence_level": "K2"
    },
