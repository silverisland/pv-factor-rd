{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pv-factor-rd/factor.schema.json",
  "title": "PV forecasting factor catalog",
  "type": "object",
  "required": ["schema_version", "factors"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "family", "mechanism_ids", "evidence_level", "status",
          "data_availability", "required_inputs", "output_type", "parameters",
          "formula", "availability_rule", "expected_horizon", "assumptions",
          "failure_modes", "implementation", "diagnostics"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^factor\\."},
          "name": {"type": "string", "minLength": 3},
          "family": {"type": "string", "minLength": 1},
          "mechanism_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^mech\\."}},
          "evidence_level": {"enum": ["K0", "K1", "K2", "K3", "K4", "K5", "K6", "E1", "E2", "E3"]},
          "status": {"enum": ["proposed", "implemented", "validated", "accepted", "rejected", "inconclusive", "deprecated"]},
          "data_availability": {"enum": ["available", "conditional", "unavailable"]},
          "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "output_type": {"enum": ["static", "history_sequence", "future_known_sequence"]},
          "parameters": {"type": "object"},
          "formula": {"type": "string", "minLength": 3},
          "availability_rule": {"type": "string", "minLength": 3},
          "expected_horizon": {"type": "object"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "implementation": {"type": ["string", "null"]},
          "diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
