{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pv-factor-rd/mechanism.schema.json",
  "title": "PV forecasting expert mechanism catalog",
  "type": "object",
  "required": ["schema_version", "mechanisms"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "claim", "causal_chain", "required_variables", "expected_horizon",
          "assumptions", "failure_modes", "source_ids", "evidence_level"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^mech\\."},
          "title": {"type": "string", "minLength": 3},
          "claim": {"type": "string", "minLength": 10},
          "causal_chain": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "required_variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_horizon": {"type": "object"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src\\."}},
          "evidence_level": {"enum": ["K0", "K1", "K2", "E1", "E2", "E3"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
